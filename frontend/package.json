{
  "name": "ignis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:list": "tsc --project tsconfig.e2e.json && playwright test --list",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^15.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
