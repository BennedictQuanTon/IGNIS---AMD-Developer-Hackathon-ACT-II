{
	admin off
	auto_https off
}

:{$PORT:7860} {
	encode gzip

	# Same contract as the Vite dev proxy: strip /api and forward to the loopback API.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8765 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Built frontend; the workspace uses hash routes, so index.html covers every path.
	handle {
		root * {$IGNIS_WEB_ROOT:/app/frontend/dist}
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
